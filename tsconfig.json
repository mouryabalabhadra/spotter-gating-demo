{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["vite/client", "@cloudflare/workers-types"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "baseUrl": ".",
        // The SDK is a `file:` dependency, so it is symlinked in with its own
        // node_modules — including @types/react 17. Without these mappings
        // TypeScript sees two React type identities and rejects every SDK
        // component as "not a valid JSX element type".
        "paths": {
            "react": ["./node_modules/@types/react"],
            "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
            "react-dom": ["./node_modules/@types/react-dom"],
            "react-dom/client": ["./node_modules/@types/react-dom/client"]
        }
    },
    "include": ["src", "worker", "vite.config.ts"]
}
